+#[cfg(feature = "fixtures")]
+fn publication_fixture_checkpoint(
+    thread_id: ThreadId,
+    point: &str,
+) -> Result<(), ThreadStoreError> {
+    let control = match std::env::var("CODEX_STORAGE_FIXTURE_PUBLICATION") {
+        Ok(control) => control,
+        Err(std::env::VarError::NotPresent) => return Ok(()),
+        Err(error) => {
+            return Err(ThreadStoreError::Internal {
+                message: error.to_string(),
+            });
+        }
+    };
+    let control: serde_json::Value =
+        serde_json::from_str(&control).map_err(|err| ThreadStoreError::Internal {
+            message: err.to_string(),
+        })?;
+    if control["thread_id"].as_str() != Some(thread_id.to_string().as_str())
+        || control["point"].as_str() != Some(point)
+    {
+        return Ok(());
+    }
+    let directory = std::path::PathBuf::from(control["directory"].as_str().ok_or_else(|| {
+        ThreadStoreError::Internal {
+            message: "fixture publication directory is absent".to_owned(),
+        }
+    })?);
+    if !directory.is_absolute() || !directory.is_dir() {
+        return Err(ThreadStoreError::Internal {
+            message: "fixture publication directory must exist".to_owned(),
+        });
+    }
+    std::fs::write(directory.join("ready"), point).map_err(|err| ThreadStoreError::Internal {
+        message: err.to_string(),
+    })?;
+    let deadline = std::time::Instant::now() + std::time::Duration::from_secs(10);
+    while !directory.join("continue").exists() {
+        if std::time::Instant::now() >= deadline {
+            return Err(ThreadStoreError::Internal {
+                message: "fixture publication timed out".to_owned(),
+            });
+        }
+        std::thread::sleep(std::time::Duration::from_millis(5));
+    }
+    Ok(())
+}
