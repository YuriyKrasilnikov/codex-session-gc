+#[cfg(feature = "fixtures")]
+fn fixture_checkpoint(request: &ClosedWorkCleanupRequest, point: &str) -> Result<()> {
+    use std::io::Read;
+    let Some(control) = &request.fixture_control else {
+        return Ok(());
+    };
+    if control.get("point").and_then(|value| value.as_str()) != Some(point) {
+        return Ok(());
+    }
+    let directory = PathBuf::from(
+        control
+            .get("directory")
+            .and_then(|value| value.as_str())
+            .ok_or("fixture control directory is absent")?,
+    );
+    require(
+        directory.is_absolute() && directory.is_dir(),
+        "fixture control directory must exist",
+    )?;
+    std::fs::write(directory.join("ready"), point).map_err(error)?;
+    if control.get("action").and_then(|value| value.as_str()) == Some("fail") {
+        let mut buffer = Vec::new();
+        std::fs::File::open(directory.join("absent-io-failure"))
+            .and_then(|mut file| file.read_to_end(&mut buffer))
+            .map_err(error)?;
+    }
+    let deadline = std::time::Instant::now() + Duration::from_secs(10);
+    while !directory.join("continue").exists() {
+        require(
+            std::time::Instant::now() < deadline,
+            "fixture checkpoint timed out",
+        )?;
+        std::thread::sleep(Duration::from_millis(5));
+    }
+    Ok(())
+}
