+async fn validate_state_identity(
+    connection: &mut sqlx::SqliteConnection,
+    request: &ClosedWorkTarget,
+) -> Result<()> {
+    let row = sqlx::query("SELECT rollout_path, updated_at_ms, source, model_provider, agent_role, history_mode, archived FROM threads WHERE id=?")
+        .bind(request.thread_id.to_string()).fetch_optional(&mut *connection).await.map_err(error)?
+        .ok_or_else(|| "target state is absent".to_owned())?;
+    let raw_source = row.try_get::<&str, _>("source").map_err(error)?;
+    // Native enum_to_string stores scalar variants as raw text and structured
+    // variants as JSON objects. These are the two representations of one schema.
+    let source: SessionSource = match raw_source.as_bytes().first() {
+        Some(b'{') => serde_json::from_str(raw_source).map_err(error)?,
+        Some(_) => serde_json::from_value(serde_json::Value::String(raw_source.to_owned()))
+            .map_err(error)?,
+        None => return Err("target source is empty".into()),
+    };
+    require(source == request.source, "origin changed")?;
+    require(
+        row.try_get::<String, _>("rollout_path").map_err(error)?
+            == request.current_rollout_path.to_string_lossy(),
+        "physical identity changed",
+    )?;
+    require(
+        row.try_get::<Option<i64>, _>("updated_at_ms")
+            .map_err(error)?
+            == Some(request.updated_at_ms),
+        "activity admission changed or is unknown",
+    )?;
+    require(
+        row.try_get::<String, _>("model_provider").map_err(error)? == request.provider,
+        "provider changed",
+    )?;
+    require(
+        row.try_get::<Option<String>, _>("agent_role")
+            .map_err(error)?
+            == request.agent_role,
+        "role changed",
+    )?;
+    require(
+        row.try_get::<String, _>("history_mode").map_err(error)?
+            == match request
+                .rollouts
+                .iter()
+                .find(|rollout| rollout.rollout_id == request.current_rollout_id)
+                .ok_or("current rollout is absent")?
+                .history_mode
+            {
+                ThreadHistoryMode::Legacy => "legacy",
+                ThreadHistoryMode::Paginated => "paginated",
+            },
+        "current history mode changed",
+    )?;
+    require(
+        row.try_get::<i64, _>("archived").map_err(error)? == i64::from(request.archived),
+        "archive identity changed",
+    )
+}
