+async fn validate_intent(
+    store: &LocalThreadStore,
+    request: &ClosedWorkCleanupRequest,
+    bytes: &[u8],
+    digest: [u8; 32],
+) -> Result<()> {
+    let journal = store
+        .config
+        .sqlite
+        .open_read_only_pool(&request.journal, Some(Duration::from_millis(100)))
+        .await
+        .map_err(error)?;
+    let mut observation = journal.begin().await.map_err(error)?;
+    let application: i64 = sqlx::query_scalar("PRAGMA application_id")
+        .fetch_one(&mut *observation)
+        .await
+        .map_err(error)?;
+    let version: i64 = sqlx::query_scalar("PRAGMA user_version")
+        .fetch_one(&mut *observation)
+        .await
+        .map_err(error)?;
+    require(
+        application == 0x43534752 && version == 2,
+        "unsupported journal identity",
+    )?;
+    let identity: (String, i64) = sqlx::query_as("SELECT name, schema_version FROM identity")
+        .fetch_one(&mut *observation)
+        .await
+        .map_err(error)?;
+    require(
+        identity == ("codex-session-gc.recovery".to_owned(), 2),
+        "journal identity changed",
+    )?;
+    let intent = sqlx::query("SELECT payload_type, payload_version, payload, digest FROM events WHERE attempt_id=? AND unit_id=? AND kind='intent'")
+        .bind(request.attempt_id.as_bytes().as_slice()).bind(request.unit_id.as_bytes().as_slice()).fetch_all(&mut *observation).await.map_err(error)?;
+    require(
+        intent.len() == 1,
+        "exact single dispatch intent is required",
+    )?;
+    let intent = &intent[0];
+    require(
+        intent.try_get::<String, _>("payload_type").map_err(error)? == CONTENT_TYPE
+            && intent.try_get::<i64, _>("payload_version").map_err(error)? == 1
+            && intent.try_get::<Vec<u8>, _>("payload").map_err(error)? == bytes
+            && intent.try_get::<Vec<u8>, _>("digest").map_err(error)? == digest,
+        "journal dispatch bytes do not match",
+    )?;
+    let terminal: i64 = sqlx::query_scalar("SELECT (SELECT COUNT(*) FROM events WHERE attempt_id=? AND unit_id=? AND kind='terminal')+(SELECT COUNT(*) FROM resolutions WHERE attempt_id=? AND unit_id=?)")
+        .bind(request.attempt_id.as_bytes().as_slice()).bind(request.unit_id.as_bytes().as_slice()).bind(request.attempt_id.as_bytes().as_slice()).bind(request.unit_id.as_bytes().as_slice()).fetch_one(&mut *observation).await.map_err(error)?;
+    require(
+        terminal == 0,
+        "terminal or reconciled units cannot be dispatched again",
+    )?;
+    let closed: i64 = sqlx::query_scalar("SELECT (SELECT COUNT(*) FROM events WHERE attempt_id=? AND kind='shutdown')+(SELECT COUNT(*) FROM lifecycle_resolutions WHERE attempt_id=?)")
+        .bind(request.attempt_id.as_bytes().as_slice()).bind(request.attempt_id.as_bytes().as_slice()).fetch_one(&mut *observation).await.map_err(error)?;
+    require(
+        closed == 0,
+        "closed attempts cannot authorize native effects",
+    )?;
+    let sequence: i64 =
+        sqlx::query_scalar("SELECT sequence FROM units WHERE attempt_id=? AND unit_id=?")
+            .bind(request.attempt_id.as_bytes().as_slice())
+            .bind(request.unit_id.as_bytes().as_slice())
+            .fetch_one(&mut *observation)
+            .await
+            .map_err(error)?;
+    let prior: i64 = sqlx::query_scalar("SELECT COUNT(*) FROM units u WHERE u.attempt_id=? AND u.sequence<? AND NOT EXISTS (SELECT 1 FROM events e WHERE e.attempt_id=u.attempt_id AND e.unit_id=u.unit_id AND e.kind='terminal' AND e.terminal_kind IN ('confirmed','refused'))")
+        .bind(request.attempt_id.as_bytes().as_slice()).bind(sequence).fetch_one(&mut *observation).await.map_err(error)?;
+    require(
+        prior == 0,
+        "an earlier unit is incomplete, partial or unknown",
+    )?;
+    observation.rollback().await.map_err(error)?;
+    journal.close().await;
+    Ok(())
+}
