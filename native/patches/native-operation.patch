+/// The only supported cleanup wire. Deserialization rejects other versions.
+#[derive(Clone, Copy, Debug, Serialize, Deserialize)]
+#[serde(try_from = "u32", into = "u32")]
+pub enum CleanupWireVersion {
+    Current,
+}
+impl TryFrom<u32> for CleanupWireVersion {
+    type Error = String;
+    fn try_from(value: u32) -> std::result::Result<Self, Self::Error> {
+        match value {
+            6 => Ok(Self::Current),
+            value => Err(format!("unsupported closed-work request version: {value}")),
+        }
+    }
+}
+impl From<CleanupWireVersion> for u32 {
+    fn from(value: CleanupWireVersion) -> Self {
+        match value {
+            CleanupWireVersion::Current => 6,
+        }
+    }
+}
