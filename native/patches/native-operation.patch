+/// Read-only physical row selection for the guarded batch validator.
+async fn observe_batch_rows(
+    connection: &mut sqlx::SqliteConnection,
+    kind: Kind,
+    selected_json: &str,
+    board_json: &str,
+) -> Result<BTreeMap<String, Vec<i64>>> {
+    let tables: &[(&str, &str)] = match kind {
+        Kind::State => &[
+            ("threads", "id"),
+            ("thread_dynamic_tools", "thread_id"),
+            ("thread_spawn_edges", "spawn"),
+            ("thread_attachments", "thread_id"),
+            ("guardian_review_feedback", "thread_id"),
+            ("thread_read_receipts", "thread_id"),
+        ],
+        Kind::Logs => &[("logs", "thread_id")],
+        Kind::Goals => &[
+            ("thread_goals", "thread_id"),
+            ("thread_goal_continuation_deferrals", "thread_id"),
+        ],
+        Kind::Memory => &[("stage1_outputs", "thread_id"), ("jobs", "job_key")],
+        Kind::History => &[
+            ("thread_items", "thread_id"),
+            ("thread_realtime_items", "thread_id"),
+            ("thread_turns", "thread_id"),
+            ("thread_history_projection_state", "thread_id"),
+        ],
+        Kind::Queue => &[
+            ("queued_items", "thread_id"),
+            ("queued_thread_revisions", "thread_id"),
+        ],
+        Kind::Board => &[
+            ("board_templates", "board"),
+            ("subscriptions", "board"),
+            ("subscription_opt_outs", "board"),
+            ("posts", "board"),
+            ("channels", "board"),
+            ("deleted_boards", "board"),
+        ],
+    };
+    let mut observed = BTreeMap::new();
+    for (table, column) in tables {
+        let clause = if *column == "spawn" {
+            "parent_thread_id IN (SELECT value FROM json_each(?)) OR child_thread_id IN (SELECT value FROM json_each(?))".to_owned()
+        } else {
+            format!(
+                "{} IN (SELECT value FROM json_each(?)){}",
+                column,
+                if *table == "jobs" {
+                    " AND kind='memory_stage1'"
+                } else {
+                    ""
+                }
+            )
+        };
+        // SQL identifiers are this finite native table list, never request strings.
+        let query = format!("SELECT rowid FROM {table} WHERE {clause} ORDER BY rowid");
+        let mut query = sqlx::query_scalar::<_, i64>(sqlx::AssertSqlSafe(query)).bind(
+            if matches!(kind, Kind::Board) {
+                board_json
+            } else {
+                selected_json
+            },
+        );
+        if *column == "spawn" {
+            query = query.bind(selected_json);
+        }
+        observed.insert(
+            (*table).to_owned(),
+            query.fetch_all(&mut *connection).await.map_err(error)?,
+        );
+    }
+    if matches!(kind, Kind::Queue) {
+        observed.insert("sqlite_sequence".to_owned(), sqlx::query_scalar(
+            "SELECT rowid FROM sqlite_sequence WHERE name='queued_thread_revisions' ORDER BY rowid",
+        ).fetch_all(&mut *connection).await.map_err(error)?);
+    }
+    Ok(observed)
+}
