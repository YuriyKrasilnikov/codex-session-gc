+async fn validate_batch_database(
+    database: &mut OwnedDatabase,
+    request: &ClosedWorkCleanupRequest,
+    selected_json: &str,
+    history_json: &str,
+    selected_ids: &[ThreadId],
+) -> Result<()> {
+    let root = request.ownership_scope.root_thread_id;
+    let root_selected = selected_ids.contains(&root);
+    let board_json = serde_json::to_string(&if root_selected {
+        vec![root.to_string()]
+    } else {
+        Vec::new()
+    })
+    .map_err(error)?;
+    let observed = observe_batch_rows(
+        &mut database.transaction,
+        database.kind,
+        if matches!(database.kind, Kind::History) {
+            history_json
+        } else {
+            selected_json
+        },
+        &board_json,
+    )
+    .await?;
+    let bound = request
+        .databases
+        .iter()
+        .find(|bound| bound.path == database.path)
+        .ok_or("owned database has no approved effect bound")?;
+    require(
+        observed == bound.rows,
+        "physical SQL union effect keys changed or exceed approved bound",
+    )?;
+    require(
+        bound.queue_bookkeeping == matches!(database.kind, Kind::Queue),
+        "queue bookkeeping declaration changed",
+    )?;
+    let expected_board = if matches!(database.kind, Kind::Board) && root_selected {
+        Some(root)
+    } else {
+        None
+    };
+    require(
+        bound.board_tombstone == expected_board,
+        "board root tombstone is outside selected scope",
+    )?;
+    if matches!(database.kind, Kind::Queue) {
+        let inconsistent: bool = sqlx::query_scalar(
+            "SELECT EXISTS(SELECT 1 FROM queued_items q WHERE q.thread_id IN (SELECT value FROM json_each(?)) AND NOT EXISTS(SELECT 1 FROM queued_thread_revisions r WHERE r.thread_id=q.thread_id))",
+        ).bind(selected_json).fetch_one(&mut *database.transaction).await.map_err(error)?;
+        require(!inconsistent, "queue revision state is inconsistent")?;
+    }
+    if matches!(database.kind, Kind::Memory) {
+        let running: bool = sqlx::query_scalar(
+            "SELECT EXISTS(SELECT 1 FROM jobs WHERE kind='memory_stage1' AND status='running' AND job_key IN (SELECT value FROM json_each(?)))",
+        ).bind(selected_json).fetch_one(&mut *database.transaction).await.map_err(error)?;
+        require(
+            !running,
+            "selected memory job is currently running, regardless of lease expiry",
+        )?;
+        let phase2: bool = sqlx::query_scalar(
+            "SELECT EXISTS(SELECT 1 FROM stage1_outputs WHERE selected_for_phase2!=0 AND thread_id IN (SELECT value FROM json_each(?)))",
+        ).bind(selected_json).fetch_one(&mut *database.transaction).await.map_err(error)?;
+        require(
+            !phase2,
+            "selected phase2 output requires unbounded global consolidation effects",
+        )?;
+    }
+    Ok(())
+}
