+/// One namespace walk for the entire batch, retaining all external ancestry/providers.
+fn validate_batch_history_dependencies(
+    request: &ClosedWorkCleanupRequest,
+    bounded: &[BoundedTarget],
+) -> Result<(Vec<PreservedZeroFile>, Vec<RetainedGuardian>)> {
+    let physical: Vec<_> = request
+        .targets
+        .iter()
+        .flat_map(|target| target.rollouts.iter().map(move |rollout| (target, rollout)))
+        .collect();
+    let checked: HashMap<_, _> = physical
+        .iter()
+        .zip(bounded)
+        .map(|((_, rollout), file)| (rollout.rollout_id, file))
+        .collect();
+    let selected_physical: HashMap<_, _> = physical
+        .iter()
+        .map(|(target, rollout)| {
+            (
+                rollout.rollout_id,
+                (target.thread_id, &rollout.rollout_path),
+            )
+        })
+        .collect();
+    let selected: HashSet<_> = request
+        .targets
+        .iter()
+        .map(|target| target.thread_id)
+        .collect();
+    let cache_ids: HashSet<_> = history_effect_ids(request).into_iter().collect();
+    let mut found = HashSet::new();
+    let mut physical_ids = HashSet::new();
+    let mut zero_ids = HashSet::new();
+    let mut providers = HashSet::new();
+    let mut preserved_zero_files = Vec::new();
+    let mut retained_guardians = Vec::new();
+    let mut directories = vec![
+        request.codex_home.join(codex_rollout::SESSIONS_SUBDIR),
+        request
+            .codex_home
+            .join(codex_rollout::ARCHIVED_SESSIONS_SUBDIR),
+    ];
+    while let Some(directory) = directories.pop() {
+        match std::fs::symlink_metadata(&directory) {
+            Err(failure) if failure.kind() == std::io::ErrorKind::NotFound => continue,
+            Err(failure) => return Err(error(failure)),
+            Ok(metadata) => require(
+                metadata.is_dir() && !metadata.is_symlink(),
+                "history directory identity is unresolved",
+            )?,
+        }
+        for entry in std::fs::read_dir(&directory).map_err(error)? {
+            let entry = entry.map_err(error)?;
+            let path = entry.path();
+            let kind = entry.file_type().map_err(error)?;
+            require(
+                !kind.is_symlink(),
+                "history namespace contains an unresolved alias",
+            )?;
+            if kind.is_dir() {
+                require(
+                    codex_rollout::rollout_id_from_path(&path).is_none(),
+                    "a directory occupies a native rollout identity",
+                )?;
+                directories.push(path);
+                continue;
+            }
+            require(
+                kind.is_file(),
+                "history namespace contains an unsupported physical object",
+            )?;
+            // Definitely empty unrelated regular files have no incoming metadata edge.
+            // Preserve their descriptor even if their basename has no rollout identity.
+            if std::fs::symlink_metadata(&path).map_err(error)?.len() == 0 {
+                let id = codex_rollout::rollout_id_from_path(&path);
+                require(
+                    !physical
+                        .iter()
+                        .any(|(_, rollout)| rollout.rollout_path == path)
+                        && codex_rollout::rollout_owner_from_path(&path)
+                            .is_none_or(|id| !selected.contains(&id)),
+                    "selected physical history is empty",
+                )?;
+                if let Some(id) = id {
+                    require(
+                        physical_ids.insert(id),
+                        "one physical rollout identity has conflicting paths",
+                    )?;
+                    zero_ids.insert(id);
+                }
+                preserved_zero_files.push(open_preserved_zero(&path)?);
+                continue;
+            }
+            let id = codex_rollout::rollout_id_from_path(&path)
+                .ok_or("history namespace contains an unsupported nonempty filename")?;
+            require(
+                physical_ids.insert(id),
+                "one physical rollout identity has conflicting paths",
+            )?;
+            let mut retained_file = None;
+            let meta = if let Some(target) = checked.get(&id) {
+                require(
+                    selected_physical
+                        .get(&id)
+                        .is_some_and(|(_, saved)| **saved == path),
+                    "selected physical path changed",
+                )?;
+                target.metadata.clone()
+            } else {
+                let (file, identity) = open_bounded_history(&path)?;
+                let representation = path_representation(&path)?;
+                let (digest, metadata) = bounded_header(&file, representation)?;
+                #[cfg(feature = "fixtures")]
+                fixture_checkpoint(request, "during_namespace_header")?;
+                let path_now = capture_physical_identity(&path)?;
+                let descriptor_now =
+                    physical_identity_from_metadata(&file.metadata().map_err(error)?)?;
+                require(
+                    path_now.device == identity.device
+                        && path_now.inode == identity.inode
+                        && descriptor_now.device == identity.device
+                        && descriptor_now.inode == identity.inode
+                        && bounded_header(&file, representation)?.0 == digest,
+                    "namespace header or descriptor identity changed",
+                )?;
+                // Unrelated append-only body growth is not a provider-header change.
+                // Selected files and separately guarded retained Guardians keep full-stat checks.
+                retained_file = Some(BoundedTarget {
+                    file,
+                    identity,
+                    metadata: metadata.clone(),
+                });
+                metadata
+            };
+            require(
+                codex_rollout::rollout_owner_from_path(&path) == Some(meta.meta.id),
+                "filename and header logical ownership disagree",
+            )?;
+            if let Some(base) = meta.meta.history_base {
+                providers.insert(base.thread_id);
+            }
+            if selected.contains(&meta.meta.id) {
+                require(
+                    selected_physical
+                        .get(&id)
+                        .is_some_and(|(owner, saved)| *owner == meta.meta.id && **saved == path)
+                        && found.insert(id),
+                    "selected owner has additional or conflicting physical rollouts",
+                )?;
+            } else {
+                require(
+                    !cache_ids.contains(&id) && !cache_ids.contains(&meta.meta.id),
+                    "retained ownership collides with selected history cache keys",
+                )?;
+                require(
+                    meta.meta
+                        .history_base
+                        .is_none_or(|base| !cache_ids.contains(&base.thread_id)),
+                    "retained history directly requires a selected physical provider",
+                )?;
+                let guardian_association = matches!(&meta.meta.source, SessionSource::SubAgent(SubAgentSource::Other(kind)) if kind == "guardian")
+                    && meta
+                        .meta
+                        .parent_thread_id
+                        .is_some_and(|id| selected.contains(&id));
+                if guardian_association {
+                    retained_guardians.push(RetainedGuardian {
+                        path: path.clone(),
+                        checked: retained_file
+                            .take()
+                            .ok_or("retained guardian descriptor is absent")?,
+                    });
+                }
+                // Logical fork ancestry records provenance in either history mode.
+                // An immutable history prefix can retain its provider; spawn and parent
+                // ownership are validated separately.
+                require(
+                    [
+                        if guardian_association {
+                            None
+                        } else {
+                            meta.meta.parent_thread_id
+                        },
+                        meta.meta.source.parent_thread_id(),
+                    ]
+                    .into_iter()
+                    .flatten()
+                    .all(|id| !selected.contains(&id)),
+                    "retained ancestry protects a selected target",
+                )?;
+            }
+        }
+    }
+    require(
+        found.len() == selected_physical.len(),
+        "selected physical namespace changed",
+    )?;
+    require(
+        zero_ids.is_disjoint(&providers),
+        "retained history requires an unresolved zero physical provider",
+    )?;
+    Ok((preserved_zero_files, retained_guardians))
+}
