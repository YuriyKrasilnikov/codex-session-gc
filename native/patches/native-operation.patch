+#[derive(Debug)]
+enum CleanupFailure {
+    Admission(String),
+    Observation(String),
+    Commit(String),
+}
+impl std::fmt::Display for CleanupFailure {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::Admission(detail) | Self::Observation(detail) | Self::Commit(detail) => {
+                formatter.write_str(detail)
+            }
+        }
+    }
+}
+impl From<&str> for CleanupFailure {
+    fn from(detail: &str) -> Self {
+        Self::Admission(detail.to_owned())
+    }
+}
+impl From<String> for CleanupFailure {
+    fn from(detail: String) -> Self {
+        Self::Admission(detail)
+    }
+}
+type Result<T> = std::result::Result<T, CleanupFailure>;
+fn error(error: impl std::fmt::Display) -> CleanupFailure {
+    CleanupFailure::Observation(error.to_string())
+}
+fn require(condition: bool, detail: &str) -> Result<()> {
+    if condition {
+        Ok(())
+    } else {
+        Err(CleanupFailure::Admission(detail.to_owned()))
+    }
+}
