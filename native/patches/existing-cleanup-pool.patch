+    /// Retains existing-storage ownership without initialization, migration or repair.
+    /// Admission and deletion must use the returned transaction connection.
+    pub async fn begin_existing_cleanup(
+        &self,
+        path: &Path,
+        busy_timeout: Duration,
+    ) -> Result<(SqlitePool, sqlx::Transaction<'static, sqlx::Sqlite>), Error> {
+        let mut journal = path.as_os_str().to_os_string();
+        journal.push("-journal");
+        if tokio::fs::try_exists(Path::new(&journal))
+            .await
+            .map_err(Error::Io)?
+        {
+            return Err(Error::Protocol(
+                "rollback journal requires external reconciliation".to_string(),
+            ));
+        }
+        let readonly = self.open_read_only_pool(path, Some(busy_timeout)).await?;
+        let mut observation = readonly.begin().await?;
+        let _: i64 = sqlx::query_scalar("SELECT COUNT(*) FROM sqlite_schema")
+            .fetch_one(&mut *observation)
+            .await?;
+        let options = SqliteConnectOptions::new()
+            .filename(path)
+            .create_if_missing(false)
+            .synchronous(SqliteSynchronous::Full)
+            .busy_timeout(busy_timeout)
+            .log_statements(LevelFilter::Off);
+        let pool = SqlitePoolOptions::new()
+            .max_connections(1)
+            .connect_with(options)
+            .await?;
+        let mut transaction = pool.begin_with("BEGIN IMMEDIATE").await?;
+        let _: i64 = sqlx::query_scalar("SELECT COUNT(*) FROM sqlite_schema")
+            .fetch_one(&mut *transaction)
+            .await?;
+        observation.rollback().await?;
+        readonly.close().await;
+        Ok((pool, transaction))
+    }
