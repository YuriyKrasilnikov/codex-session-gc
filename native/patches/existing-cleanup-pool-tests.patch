+#[tokio::test]
+async fn cleanup_open_never_creates_missing_storage_or_initializes_existing_storage()
+-> anyhow::Result<()> {
+    let home = crate::runtime::test_support::unique_temp_dir();
+    tokio::fs::create_dir_all(&home).await?;
+    let _cleanup = scopeguard::guard(home.clone(), |home| {
+        let _ = std::fs::remove_dir_all(home);
+    });
+    let sqlite = SqliteConfig::new_for_testing(home.as_path().abs());
+    let missing = home.join("missing.sqlite");
+    assert!(
+        sqlite
+            .begin_existing_cleanup(&missing, std::time::Duration::from_millis(100))
+            .await
+            .is_err()
+    );
+    assert!(!missing.exists());
+    let path = home.join("existing.sqlite");
+    let fixture = SqlitePoolOptions::new()
+        .max_connections(1)
+        .connect_with(
+            SqliteConnectOptions::new()
+                .filename(&path)
+                .create_if_missing(true)
+                .journal_mode(SqliteJournalMode::Delete),
+        )
+        .await?;
+    sqlx::query("CREATE TABLE retained(value TEXT)")
+        .execute(&fixture)
+        .await?;
+    sqlx::query("INSERT INTO retained VALUES ('unchanged')")
+        .execute(&fixture)
+        .await?;
+    fixture.close().await;
+    let (pool, mut transaction) = sqlite
+        .begin_existing_cleanup(&path, std::time::Duration::from_millis(100))
+        .await?;
+    let mode: String = sqlx::query_scalar("PRAGMA journal_mode")
+        .fetch_one(&mut *transaction)
+        .await?;
+    let value: String = sqlx::query_scalar("SELECT value FROM retained")
+        .fetch_one(&mut *transaction)
+        .await?;
+    let migrations: i64 =
+        sqlx::query_scalar("SELECT COUNT(*) FROM sqlite_schema WHERE name='_sqlx_migrations'")
+            .fetch_one(&mut *transaction)
+            .await?;
+    assert_eq!(mode, "delete");
+    assert_eq!(value, "unchanged");
+    assert_eq!(migrations, 0);
+    transaction.rollback().await?;
+    pool.close().await;
+    Ok(())
+}
