+        connection: &mut sqlx::SqliteConnection,
+        thread_ids: &[ThreadId],
+    ) -> anyhow::Result<(u64, u64)> {
+        let mut feedback_rows = 0;
+        let mut receipt_rows = 0;
+        for thread_id in thread_ids {
+            let thread_id = thread_id.to_string();
+            feedback_rows +=
+                sqlx::query("DELETE FROM guardian_review_feedback WHERE thread_id = ?")
+                    .bind(&thread_id)
+                    .execute(&mut *connection)
+                    .await?
+                    .rows_affected();
+            receipt_rows += sqlx::query("DELETE FROM thread_read_receipts WHERE thread_id = ?")
+                .bind(&thread_id)
+                .execute(&mut *connection)
+                .await?
+                .rows_affected();
+        }
+        Ok((feedback_rows, receipt_rows))
+    }
