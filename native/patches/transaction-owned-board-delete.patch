+    /// Recognizes the exact board schema without changing source storage.
+    pub async fn validate_cleanup_schema(connection: &mut sqlx::SqliteConnection) -> Result<()> {
+        let reference = sqlx::sqlite::SqlitePoolOptions::new()
+            .max_connections(1)
+            .connect("sqlite::memory:")
+            .await
+            .map_err(storage_error)?;
+        sqlx::raw_sql(SCHEMA)
+            .execute(&reference)
+            .await
+            .map_err(storage_error)?;
+        let query = "SELECT type, name, tbl_name, sql FROM sqlite_schema WHERE name NOT LIKE 'sqlite_%' ORDER BY type, name";
+        let expected: Vec<(String, String, String, Option<String>)> = sqlx::query_as(query)
+            .fetch_all(&reference)
+            .await
+            .map_err(storage_error)?;
+        let observed: Vec<(String, String, String, Option<String>)> = sqlx::query_as(query)
+            .fetch_all(connection)
+            .await
+            .map_err(storage_error)?;
+        reference.close().await;
+        if expected != observed {
+            return Err(storage_error(sqlx::Error::Protocol(
+                "board schema is not qualified for cleanup".to_string(),
+            )));
+        }
         Ok(())
     }
 
