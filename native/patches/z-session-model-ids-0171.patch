+struct RetainedAliasHeader {
+    path: PathBuf,
+    identity: PhysicalIdentity,
+    digest: [u8; 32],
+    representation: RolloutRepresentation,
+    session_id: String,
+    owner_id: String,
+    ambiguous_agent_session: bool,
+}
+impl RetainedAliasHeader {
+    fn recheck(&self) -> Result<()> {
+        let (file, identity) = open_bounded_history(&self.path)?;
+        require(
+            identity.device == self.identity.device
+                && identity.inode == self.identity.inode
+                && bounded_header(&file, self.representation)?.0 == self.digest,
+            "retained session header changed",
+        )
+    }
+}
